    "@types/ssh2": "^1.15.4",
    "@types/tar": "^6.1.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
